# Função para ler matriz do usuário
def ler_matriz():
    print("Digite a quantidade de movimentos do Jogador X (linhas): ")
    m = int(input())

    print("Digite a quantidade de movimentos do Jogador Y (colunas): ")
    n = int(input())

    print(f"Agora digite a matriz {m}x{n} linha por linha:")
    A = []

    for i in range(m):
        linha = list(map(float, input(f"Linha {i+1}: ").split()))
        while len(linha) != n:
            print("Quantidade incorreta de elementos! Digite novamente.")
            linha = list(map(float, input(f"Linha {i+1}: ").split()))
        A.append(linha)

    return A, m, n

# Verifica ponto de sela
def ponto_de_sela(A):
    m = len(A)
    n = len(A[0])

    for i in range(m):
        # menor valor da linha i
        min_val = min(A[i])
        j = A[i].index(min_val)

        # verificar se é o maior da coluna j
        col_max = max(A[k][j] for k in range(m))

        if min_val == col_max:
            return True, i, j, min_val

    return False, None, None, None
# Resolver estratégias mistas SOMENTE PARA MATRIZ 2x2
# Fórmulas da Teoria dos Jogos (jogo zero-soma)
# A = [ [a, b],  [c, d] ]
# Jogador X:  p = (d - c) / (a - b - c + d)
# Jogador Y:  q = (d - b) / (a - b - c + d)
# Valor do jogo: v = (a*d - b*c) / (a - b - c + d)

def misto_2x2(A):

    a = A[0][0]
    b = A[0][1]
    c = A[1][0]
    d = A[1][1]

    denom = a - b - c + d

    if denom == 0:
        return None, None, None  # sistema degenerado

    # probabilidades do Jogador X
    p1 = (d - c) / denom
    p2 = 1 - p1

    # probabilidades do Jogador Y
    q1 = (d - b) / denom
    q2 = 1 - q1

    # valor do jogo
    v = (a * d - b * c) / denom

    return (p1, p2), (q1, q2), v

# Função principal
def main():
    A, m, n = ler_matriz()

    print("\n--- MATRIZ DIGITADA ---")
    for linha in A:
        print(linha)

    # Verificar ponto de sela
    existe, i, j, valor = ponto_de_sela(A)

    if existe:
        print("\n>>> Existe ponto de sela!")
        print(f"Jogador X deve jogar movimento {i+1}")
        print(f"Jogador Y deve jogar movimento {j+1}")
        print(f"Valor do jogo = {valor}")
        return

    # Se não existe ponto de sela e matriz NÃO é 2x2 → não dá para resolver
    if m != 2 or n != 2:
        print("\n>>> NÃO existe ponto de sela.")
        print(">>> Este programa sem bibliotecas só resolve estratégias mistas para matrizes 2x2.")
        print(">>> Sua matriz NÃO é 2x2. Não é possível calcular estratégias mistas.")
        return

    # Resolver estratégia mista 2x2
    p, q, v = misto_2x2(A)

    if p is None:
        print("O sistema é degenerado e não pode ser resolvido.")
        return

    print("\n>>> Não existe ponto de sela. Calculando estratégias mistas (2x2)...")

    print("\nEstratégia ótima do Jogador X (p*):")
    print(f"  Movimento 1: {p[0]:.4f}")
    print(f"  Movimento 2: {p[1]:.4f}")

    print("\nEstratégia ótima do Jogador Y (q*):")
    print(f"  Movimento 1: {q[0]:.4f}")
    print(f"  Movimento 2: {q[1]:.4f}")

    print(f"\nValor do jogo: {v:.4f}")

# Executa o programa
main()
